{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "next build",
    "watchPatterns": [
      "src/**",
      "public/**",
      "package.json"
    ]
  },
  "deploy": {
    "startCommand": "next start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}

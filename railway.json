{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "prisma generate && next build",
    "watchPatterns": [
      "src/**",
      "prisma/**",
      "package.json"
    ]
  },
  "deploy": {
    "startCommand": "prisma db push --accept-data-loss && next start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}

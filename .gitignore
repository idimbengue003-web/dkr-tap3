# .gitignore racine — protège les fichiers système/métas
# (le .gitignore du projet est dans dkr-tap/.gitignore)

# Fichiers sensibles
.env
.env.local
.env.*.local

# Build artifacts
.next/
out/
build/

# Logs
*.log
dev.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dépendances (à la racine)
node_modules/

# Cache
.DS_Store
*.pem

# Tool results (sandbox)
tool-results/
upload/

DATABASE_URL=file:/home/z/my-project/db/custom.db

# Mot de passe pour accéder à l'interface admin et à l'API /api/stickers
# À changer ABSOLUMENT en production. Sans cette variable, l'accès est bloqué.
ADMIN_PASSWORD=changer-moi-en-production-2026
AUTH_SESSION_HOURS=24

# === Branding (visible côté client ET côté serveur) ===
# Nom de marque affiché en haut de l'admin et sur la page d'attente des scans QR.
NEXT_PUBLIC_BRAND_NAME=ScanBridge

# URL du logo affiché à côté du nom de marque.
# Par défaut : logo SVG local dans /public (zéro dépendance externe).
# Pour utiliser votre propre logo, mettez une URL publique ou un chemin /public local.
NEXT_PUBLIC_BRAND_LOGO_URL=/scanbridge-logo.svg

# ============================================================
# DKR TAP — Configuration (exemple)
# ============================================================
# Copiez ce fichier vers `.env` et adaptez les valeurs.
# OU configurez les variables directement sur Vercel (recommandé en prod).
#
# ⚠️  NE JAMAIS committer .env (il est déjà dans .gitignore).
#     En prod, utilisez le dashboard Vercel → Settings → Environment Variables.
# ============================================================

# === Storage (Vercel KV) ===
# Sur Vercel : créez une KV database dans le dashboard → les variables
# KV_REST_API_URL et KV_REST_API_TOKEN seront automatiquement injectées.
# En dev local sans KV : un MockKV en mémoire est utilisé automatiquement
# (les données ne persistent pas entre redémarrages — c'est attendu pour le dev).
#
# Pour tester en local avec un vrai KV :
#   1) Créez la KV database sur Vercel (dashboard)
#   2) vercel link
#   3) vercel env pull .env.local
#
# Les variables suivantes sont auto-injectées par Vercel (NE PAS mettre ici) :
# KV_REST_API_URL=
# KV_REST_API_TOKEN=


# === Sécurité (REQUIS) ===
# Mot de passe pour accéder à l'interface admin et à l'API /api/stickers.
# À changer ABSOLUMENT en production — utilisez un mot de passe fort.
ADMIN_PASSWORD=changer-moi-en-production-2026

# Durée de validité du cookie admin en heures (default: 24)
AUTH_SESSION_HOURS=24


# === Branding (visible côté client ET côté serveur) ===
# Nom de marque affiché en haut de l'admin, sur la page d'attente, sur les stickers
NEXT_PUBLIC_BRAND_NAME=DKR TAP

# URL du logo de marque (chemin /public local ou URL externe)
NEXT_PUBLIC_BRAND_LOGO_URL=/scanbridge-logo.svg

# Téléphone affiché en bas des stickers + page d'attente
NEXT_PUBLIC_BRAND_PHONE=78 927 12 96

# Lien de paiement Wave (format: https://pay.wave.com/...)
# L'utilisateur fournira son lien Wave plus tard. Laisser vide pour utiliser l'appel téléphonique.
NEXT_PUBLIC_WAVE_PAYMENT_URL=
